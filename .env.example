# Configure one persistent database for production:
# DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/playnexus?retryWrites=true&w=majority

# Generate a unique, random value (for example: openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Server Configuration
PORT=3000
